---
layout: base.njk
permalink: /
---
<section class="hero panel">
  <h1>Welcome to the Garage</h1>
  <p>
    Vlogs and write-ups from the shop — woodworking, CNC, 3D printing,
    automotive, restoration, and whatever else ends up on the workbench.
  </p>
  <p>
    <a class="btn" href="{{ site.youtubeChannel }}" rel="noopener noreferrer" target="_blank">Watch on YouTube</a>
    <a class="btn btn--ghost" href="/posts/">Browse all posts</a>
  </p>
</section>

<section class="recent">
  <h2 class="section-title">Latest from the shop</h2>
  <ul class="post-list">
    {% for post in collections.posts | head(site.postsPerPage) %}
    <li class="post-card panel">
      <h3 class="post-card__title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h3>
      <p class="post-card__meta">
        <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
        {% if post.data.categories %}
        ·
        {% for cat in post.data.categories %}
        <a class="cat-pill" href="/category/{{ cat | slugify }}/">{{ cat }}</a>
        {% endfor %}
        {% endif %}
      </p>
      {% if post.data.summary %}
      <p class="post-card__summary">{{ post.data.summary }}</p>
      {% endif %}
      <p><a class="more" href="{{ post.url }}">Read more &raquo;</a></p>
    </li>
    {% else %}
    <li class="panel">No posts yet. Check back soon!</li>
    {% endfor %}
  </ul>
</section>

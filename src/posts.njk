---
layout: base.njk
permalink: /posts/
title: All Posts
---
<section class="panel">
  <h1>All Posts</h1>
  <p>Everything that's come out of the garage, newest first.</p>
</section>

<ul class="post-list">
  {% for post in collections.posts %}
  <li class="post-card panel">
    <h2 class="post-card__title">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h2>
    <p class="post-card__meta">
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
      {% if post.data.categories %}
      ·
      {% for cat in post.data.categories %}
      <a class="cat-pill" href="/category/{{ cat | slugify }}/">{{ cat }}</a>
      {% endfor %}
      {% endif %}
    </p>
    {% if post.data.summary %}
    <p class="post-card__summary">{{ post.data.summary }}</p>
    {% endif %}
  </li>
  {% else %}
  <li class="panel">No posts yet.</li>
  {% endfor %}
</ul>
